# Copy to .env and adjust. Environment variables override config.toml.

# ── Dashboard ───────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8036
WEB_USERNAME=admin
# Set a password before exposing the dashboard publicly.
WEB_PASSWORD=

# ── Mode ────────────────────────────────────────────────────────────────────
# Two server-side gates must both be open before per-asset live mode can work:
#   LIVE_ENABLED=true  -> construct the live broker at all
#   PAPER_TRADING=false -> stop forcing every asset to paper
# With PAPER_TRADING=true, the config page locks live and every asset stays paper.
# After both are set, choose paper/live independently per coin on /config.
PAPER_TRADING=true
LIVE_ENABLED=false

# ── Live CLOB credentials (only used when LIVE_ENABLED=true) ────────────────
API_KEY=
API_SECRET=
API_PASSPHRASE=
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
FUNDER_ADDRESS=
SIGNATURE_TYPE=0

# ── Market-data recording (backtest / replay) ──────────────────────────────
# Reuses the live RTDS/CLOB connections and writes hourly JSONL under
# DATA_DIR/live. Roughly 250-400 MB/day plain for BTC+ETH, ~30-50 MB/day
# after compression. Set RECORDING_ENABLED=false to turn it off.
# RECORDING_ENABLED=true
# RECORDING_DIR=                 # empty -> <DATA_DIR>/live
# RECORDING_BOOK_HZ=1
# RECORDING_BOOK_LEVELS=5
# RECORDING_RAW_CLOB=false       # raw CLOB is several GB/day
# RECORDING_TWAP=true
# RECORDING_GZIP=true
# RECORDING_RETENTION_DAYS=14    # 0 = keep forever
# RECORDING_QUEUE_SIZE=50000

# ── Optional overrides ──────────────────────────────────────────────────────
# ASSETS=BTC,ETH
# DATA_DIR=./data
# MIN_EDGE=0.05
# MAX_POSITION_USD=5
